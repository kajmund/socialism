{
  "mcpServers": {
    "opinionssimulator": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/absolute/path/to/socialism/integrations/mcp",
        "python",
        "server.py"
      ],
      "env": {
        "DEEPSEEK_API_KEY": "your-deepseek-key",
        "OPINIONSSIMULATOR_API_URL": "http://127.0.0.1:8000"
      }
    },
    "spinndoktor": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/absolute/path/to/socialism/integrations/mcp",
        "python",
        "spinndoctor_server.py"
      ],
      "env": {
        "ARTIFACT_ROOT": "/absolute/path/to/socialism/backend/data/reports"
      }
    },
    "kibana": {
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "--directory",
        "/absolute/path/to/socialism/integrations/mcp",
        "python",
        "kibana_server.py"
      ],
      "env": {
        "ELASTICSEARCH_URL": "https://your-elasticsearch-host:9200",
        "ELASTICSEARCH_INDEX": "logs-socialism-*",
        "ELASTICSEARCH_API_KEY": "your-encoded-read-only-api-key"
      }
    }
  }
}
