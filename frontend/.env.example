# Supabase: Dashboard → Project Settings → API
# Only public (browser-safe) values belong here — never the service_role key or database URL.

# --- Backend API ---

# Production / direct API: full backend URL.
VITE_API_BASE_URL=http://localhost:8000
# Local dev: route HTTP + WS through Vite (see vite.config.ts proxy). Avoids CORS
# when the dev server picks another port (5174, …). Requires backend on :8000.
VITE_DEV_PROXY=true

# --- Supabase (browser auth) ---

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
