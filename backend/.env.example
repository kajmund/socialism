# --- Database (SQLite for local phase 1; swap to Postgres later) ---

# Relative paths resolve from the process working directory (usually backend/).
DATABASE_URL=sqlite+aiosqlite:///./data/opinionssimulator.db

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LLM (required) — DeepSeek ---

# Required at startup. App will not boot without a non-empty key.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# deepseek (default) | stub — stub only for offline persona sampling in tests.
PERSONA_GENERATOR=deepseek

# --- Simulation (körningar) ---

# none = start only flips status (Phase 1 default)
# oasis = live CAMEL OASIS spike (requires: uv sync --extra oasis)
SIMULATION_ENGINE=none
