# --- Database (required Supabase Postgres connection) ---

# Supabase direct/session connection for the long-running backend process.
# Plain postgresql:// and postgres:// URLs are normalized to psycopg automatically.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:3000,https://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3000

# --- LLM (required) — Cerebras default, DeepSeek A/B ---

# Shared OpenAI-compatible chat/completions. No automatic provider fallback.
LLM_PROVIDER=cerebras
# Empty uses the provider default (gpt-oss-120b or DEEPSEEK_MODEL).
# LLM_MODEL=
LLM_REASONING_EFFORT=medium
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=60
# Neutral document Q&A uses its own bounded budget and longer per-batch timeout.
DOCUMENT_KNOWLEDGE_LLM_MAX_TOKENS=8192
DOCUMENT_KNOWLEDGE_LLM_TIMEOUT_SECONDS=180

# Required when LLM_PROVIDER=cerebras. App will not boot without a non-empty key.
CEREBRAS_API_KEY=csk-...
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1

# Used when LLM_PROVIDER=deepseek (same complete_* path). Also required for OASIS.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# TypeSafe Jev — Auto prompt selection. Empty key falls back to the prompt/default config.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-latest
# JEV_CONFIDENCE_THRESHOLD=0.6
# JEV_TIMEOUT_SECONDS=3
# JEV_STATE_CHAR_BUDGET=8000
# Research fast controller (separate from Auto prompt selection). Empty key disables it.
# RESEARCH_JEV_ENABLED=false
# RESEARCH_JEV_MODE=shadow
# RESEARCH_JEV_MODEL=jev-1.12
# RESEARCH_JEV_SUFFICIENT_THRESHOLD=0.9
# RESEARCH_JEV_INCOMPLETE_THRESHOLD=0.85
# RESEARCH_JEV_CONFIDENCE_THRESHOLD=0.8
# RESEARCH_JEV_MAX_EVIDENCE_ITEMS=24
# RESEARCH_JEV_MAX_STATE_CHARS=6000
# RESEARCH_JEV_CONCURRENCY=8
# RESEARCH_JEV_TIMEOUT_SECONDS=5
# RESEARCH_JEV_EVIDENCE_SCREEN_ENABLED=true

# deepseek (default) | stub — stub only for offline persona sampling in tests.
# The selected chat provider key is still required at startup when using stub.
PERSONA_GENERATOR=deepseek

# --- Embeddings (required) — OpenAI SSR ---

# Separate from chat LLM. Used by Semantic Similarity Rating in reports.
# OASIS still uses DEEPSEEK via apply_oasis_env (overwrites process OPENAI_API_KEY).
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_TIMEOUT_SECONDS=60
# Write-through SSR anchor embedding cache (relative to backend cwd).
EMBEDDING_CACHE_DIR=data/embedding_cache
# Budskap image bytes + vision captions (SHA256 keys).
IMAGE_CACHE_DIR=data/image_cache

# --- Expert memory (Mem0 OSS + Supabase Postgres/pgvector) ---

# Uses DATABASE_URL for vectors, extracted-memory history, and recent messages.
MEM0_COLLECTION_NAME=expert_memories
MEM0_EMBEDDING_MODEL=text-embedding-3-small
MEM0_SEARCH_LIMIT=10
MEM0_TELEMETRY=false
# Cerebras vision-capable model for image memories. Do not use GPT/gpt-oss.
MEM0_VISION_MODEL=qwen-3.8-27b
MEM0_VISION_DETAILS=high

# --- Playground vision (optional providers) ---

# Default OpenAI vision model when not overridden in Bildtest UI.
VISION_MODEL=gpt-4o-mini
VISION_TIMEOUT_SECONDS=60

# Optional — enable Google Gemini in playground Bildtest when set.
# GOOGLE_API_KEY=...
# GOOGLE_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# The same key is required when LIVE_VOICE_PROVIDER=gemini (default).
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# GEMINI_LIVE_VOICE=Algenib
# GOOGLE_LIVE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_LIVE_TOKEN_TTL_SECONDS=600
# GEMINI_LIVE_NEW_SESSION_TTL_SECONDS=60

# --- Live voice (expert chat) ---
# gemini (default) | elevenlabs. No automatic fallback between providers.
LIVE_VOICE_PROVIDER=gemini
# Required when LIVE_VOICE_PROVIDER=elevenlabs. Browser talks to ElevenLabs
# after the backend mints a signed URL; audio never hits this API.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_VOICE_ID=
# Optional JSON map of OpenAI tool name → ElevenLabs client tool id.
# When set, every allowlisted expert tool must have an id (fail loud).
# Client tools must already exist on the shell agent with expects_response=true.
# ELEVENLABS_TOOL_IDS={"lookup_company":"tool_...","search_wiki":"tool_..."}
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# ELEVENLABS_SIGNED_URL_TTL_SECONDS=900

# Optional — enable Ollama Cloud in playground Bildtest when set.
# OLLAMA_API_KEY=...
# OLLAMA_BASE_URL=https://ollama.com

# --- BolagsAPI (optional) — DD company search ---

# When set, company tools (sourcing chat, DD experts, Spinndoktor, expert chat)
# use BolagsAPI MCP. When empty, the same tools scrape Allabolag.se.
# BOLAGSAPI_API_KEY=
# BOLAGSAPI_MCP_URL=https://mcp.bolagsapi.se/mcp
# Disk cache for company tool results (10-month TTL). Relative to backend cwd.
# BOLAGSAPI_CACHE_DIR=data/bolagsapi_cache

# --- Supabase Auth (required) ---

# Project URL (Settings → API). Used by backend Admin invite in later phases.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service role key — backend only, never expose to the SPA.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage Vector Bucket in this project. Created when missing.
SUPABASE_VECTOR_BUCKET=research-knowledge
SUPABASE_VECTOR_INDEX=documents-openai
SUPABASE_VECTOR_DISTANCE_METRIC=cosine
# Canonical research questions share the vector index but use isolated metadata.
RESEARCH_QUESTION_SEMANTIC_MATCH_THRESHOLD=0.88
RESEARCH_QUESTION_SEMANTIC_MATCH_LIMIT=8
RESEARCH_QUESTION_EMBEDDING_VERSION=knowledge-question-v1
# Local-only sign-in at /dev-in (erik@fremred.se / Devbrains). Never set in production.
# ALLOW_LOCAL_LOGIN=true
# LOCAL_AUTH_JWT_SECRET=generate-a-long-random-development-secret
# Storage S3 (Dashboard → Storage → S3). Required to upload files / persist reports.
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_S3_REGION=eu-central-1

# --- Simulation (körningar) ---

# none = start only flips status (Phase 1 default)
# oasis = live CAMEL OASIS spike (requires: uv sync --extra oasis)
SIMULATION_ENGINE=none

# Max overlapping run_simulate jobs (1–32). A/B variants inside one job still
# run in parallel; this only caps distinct körningar started at once.
MAX_CONCURRENT_SIMULATION_JOBS=2

# Max concurrent LLM persona calls within one population generate batch (1–32).
# Names are pre-assigned; profiles run in parallel, anecdotes in waves of this size.
# PERSONA_GENERATE_CONCURRENCY=8

# Max concurrent Word-review LLM calls within one expertgranskning job (1–32).
# WORD_REVIEW_MAX_CONCURRENCY=8
# Optional Word router override. Empty inherits the global LLM model.
# WORD_REVIEW_ROUTER_MODEL=
# WORD_REVIEW_ROUTER_MAX_TOKENS=256

# --- API process log (rotating file; console still goes to uvicorn stdout) ---

# Empty LOG_DIR disables the file. Relative to backend cwd.
LOG_DIR=data/logs
LOG_MAX_BYTES=2000000
LOG_BACKUP_COUNT=5
LOG_LEVEL=INFO

# Optional remote ELK drain. Configure all three together; URL must use HTTPS.
# Delivery runs on a bounded background queue and never blocks API request handling.
# LOGSTASH_URL=https://socialism-logstash.fly.dev
# LOGSTASH_USERNAME=socialism
# LOGSTASH_PASSWORD=generate-a-long-random-secret
# LOG_SERVICE=socialism-backend
# LOG_ENVIRONMENT=local
# LOGSTASH_TIMEOUT_SECONDS=10
# LOGSTASH_QUEUE_SIZE=512

# LibreOffice for Word (.docx) → PDF underlag conversion (optional; default soffice on PATH)
# LIBREOFFICE_BIN=/usr/bin/soffice
