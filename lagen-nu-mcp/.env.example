# Supabase Postgres (service role / direct connection). Required for live poll/fetch.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# Identify us to lagen.nu (ideell volontärtjänst).
LAGEN_NU_USER_AGENT=lagen-nu-mcp/0.1 (+https://github.com/kajmund/lagen-nu-mcp; erik@devbrains.se)

# Max ~1 req/s mot lagen.nu.
LAGEN_NU_MIN_INTERVAL_SECONDS=1.0

# roots = 6 kategorifeeds (default, artigt).
# all = alla Atom-länkar på /dataset/sitenews utom sitenews själv.
LAGEN_NU_FEED_MODE=roots

LOG_LEVEL=INFO
